{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Clear-Site-Data", "value": "\"cache\"" }]
    },
    {
      "source": "/(sobre|karlu|produto|parceria)",
      "headers": [{ "key": "Clear-Site-Data", "value": "\"cache\"" }]
    }
  ]
}
